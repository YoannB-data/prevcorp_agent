{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_python.py"]
          }
        ]
      }
    ]
  }
}
