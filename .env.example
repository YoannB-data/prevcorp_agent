# Clé API Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Chemin vers le fichier manifest.json généré par dbt (couche marts uniquement)
MANIFEST_PATH=/chemin/vers/target/manifest.json

# Chemin vers le fichier semantic_manifest.json généré par dbt
SEMANTIC_MANIFEST_PATH=/chemin/vers/target/semantic_manifest.json

# Chemin vers la base DuckDB (ouverte en lecture seule)
DUCKDB_PATH=/chemin/vers/base.duckdb
